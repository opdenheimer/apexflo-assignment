# Application Configuration
APP_NAME="ApexFlo In-Cinema Commerce"
APP_ENV=development
PORT=8000
DEBUG=True

# Database (PostgreSQL)
# Note: uses asyncpg for high-concurrency async operations
DATABASE_URL=postgresql+asyncpg://apexflo:yourpassword@localhost:5432/apexflo_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30

# Cache & Message Broker (Redis)
REDIS_URL=redis://localhost:6379/0

# Security / Token Secret for Stateless Patron & Admin Tokens
SECRET_KEY=apexflo_production_secret_key_cinema
ALGORITHM=HS256
ADMIN_ACCESS_KEY= YOUR_ADMIN_ACCESS_KEY 
